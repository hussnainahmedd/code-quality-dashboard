# ===========================================
# Code Quality Dashboard - Environment Config
# ===========================================

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./code_quality.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/code_quality_db

# GitHub OAuth2 App
# Create one at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Frontend URL (for OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Demo Mode (set to True to use without GitHub OAuth)
DEMO_MODE=True

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
